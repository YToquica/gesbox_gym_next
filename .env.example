# Reemplaza los valores con las credenciales de tu proyecto de Supabase
NEXT_PUBLIC_SUPABASE_URL=tu_supabase_url_aqui
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_supabase_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key_aqui

# Credenciales de MercadoPago
MERCADOPAGO_ACCESS_TOKEN=tu_access_token_de_mercadopago_aqui
MERCADOPAGO_WEBHOOK_SECRET=tu_webhook_secret_aqui
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Credenciales de Google reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=tu_recaptcha_site_key_aqui
RECAPTCHA_SECRET_KEY=tu_recaptcha_secret_key_aqui
